# Environment for running the MCP server outside Docker (copy to .env).
# In the deployed stack these are set by the mcp-vm.yml compose template.

SEARXNG_URL=http://localhost:8080
# Host header(s) nginx sends upstream; enables DNS-rebinding protection. Empty = off.
MCP_ALLOWED_HOSTS=mcp-host.example.ts.net:8000
FETCH_MAX_BYTES=5242880
FETCH_TIMEOUT=20
FETCH_USER_AGENT=Mozilla/5.0 (compatible; homelab-mcp-fetch/1.0)
