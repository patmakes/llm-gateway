# {{ ansible_managed }}
use_default_settings: true

general:
  instance_name: "mcp-search"

server:
  secret_key: "{{ searxng_secret_key }}"
  limiter: false          # private instance, only the MCP container talks to it
  image_proxy: false
  public_instance: false

search:
  safe_search: 0
  formats:
    - html
    - json                # required: the MCP server uses /search?format=json

outgoing:
  request_timeout: 6.0
  max_request_timeout: 12.0
